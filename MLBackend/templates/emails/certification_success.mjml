<mjml>
  <mj-head>
    <mj-title>Félicitations ! - MLAcademy</mj-title>
    <mj-preview>🎓 Vous avez obtenu votre certification — Félicitations {{ student_name }} !</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="26px" />
    </mj-attributes>
    <mj-style>
      .divider-gold { border-top: 2px solid #f59e0b; width: 60px; margin: 0 auto; }
      .badge { display: inline-block; background: #fef3c7; color: #b45309;
               padding: 4px 14px; border-radius: 999px; font-size: 12px;
               font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">

    <!-- HEADER BRAND -->
    <mj-section background-color="#0f172a" padding="24px 40px" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="800" color="#ffffff" letter-spacing="2px">
          ML<span style="color:#f59e0b;">Academy</span>
        </mj-text>
        <mj-text align="center" font-size="11px" color="#94a3b8" letter-spacing="3px" padding-top="0px">
          CERTIFICATION OFFICIELLE
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HERO SECTION -->
    <mj-section background-color="#ffffff" padding="48px 40px 32px">
      <mj-column>

        <!-- Médaille -->
        <mj-text align="center" font-size="56px" padding-bottom="8px">🏅</mj-text>

        <!-- Badge statut -->
        <mj-text align="center" padding-bottom="16px">
          <span class="badge">✦ Certification Validée</span>
        </mj-text>

        <!-- Titre principal -->
        <mj-text align="center" font-size="28px" font-weight="800" color="#0f172a" line-height="36px" padding-bottom="8px">
          Félicitations,<br/>{{ student_name }} !
        </mj-text>

        <!-- Ligne dorée -->
        <mj-divider border-color="#f59e0b" border-width="2px" width="60px" padding="8px 0 24px" />

        <!-- Message principal -->
        <mj-text align="center" color="#4b5563" font-size="15px" line-height="28px" padding-bottom="24px">
          Vous avez brillamment complété et validé le projet<br/>
          <strong style="color:#0f172a;">"{{ project_title }}"</strong><br/>
          dans le cadre du programme <strong style="color:#0f172a;">{{ course_name }}</strong>.
        </mj-text>

        <!-- Score card -->
        <mj-section padding="0" border-radius="12px" background-color="#f0fdf4">
          <mj-column>
            <mj-text align="center" padding="20px">
              <span style="display:block; font-size:11px; font-weight:700; color:#6b7280; letter-spacing:2px; text-transform:uppercase; margin-bottom:6px;">Score Final</span>
              <span style="display:block; font-size:48px; font-weight:900; color:#10b981; line-height:1;">{{ final_score }}%</span>
              <span style="display:block; font-size:13px; color:#6b7280; margin-top:4px;">Évalué par {{ reviewer_count }} pairs • {{ review_date }}</span>
            </mj-text>
          </mj-column>
        </mj-section>

      </mj-column>
    </mj-section>

    <!-- DÉTAIL DES CRITÈRES -->
    <mj-section background-color="#ffffff" padding="0 40px 32px">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" color="#6b7280" letter-spacing="2px" padding-bottom="12px">
          DÉTAIL DE L'ÉVALUATION
        </mj-text>

        <!-- Critère 1 -->
        <mj-text padding="6px 0">
          <span style="display:flex; justify-content:space-between;">
            <span style="color:#374151;">📐 Structure & Organisation</span>
            <strong style="color:#0f172a;">{{ score_structure }}/5</strong>
          </span>
        </mj-text>
        <mj-divider border-color="#f3f4f6" border-width="1px" padding="0" />

        <!-- Critère 2 -->
        <mj-text padding="6px 0">
          <span style="display:flex; justify-content:space-between;">
            <span style="color:#374151;">💡 Clarté & Communication</span>
            <strong style="color:#0f172a;">{{ score_clarte }}/5</strong>
          </span>
        </mj-text>
        <mj-divider border-color="#f3f4f6" border-width="1px" padding="0" />

        <!-- Critère 3 -->
        <mj-text padding="6px 0">
          <span style="display:flex; justify-content:space-between;">
            <span style="color:#374151;">⚙️ Exactitude Technique</span>
            <strong style="color:#0f172a;">{{ score_technique }}/5</strong>
          </span>
        </mj-text>
        <mj-divider border-color="#f3f4f6" border-width="1px" padding="0" />

        <!-- Critère 4 -->
        <mj-text padding="6px 0">
          <span style="display:flex; justify-content:space-between;">
            <span style="color:#374151;">✨ Originalité & Créativité</span>
            <strong style="color:#0f172a;">{{ score_originalite }}/5</strong>
          </span>
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- CTA BUTTONS -->
    <mj-section background-color="#ffffff" padding="0 40px 48px">
      <mj-column>

        <mj-divider border-color="#e5e7eb" border-width="1px" padding-bottom="24px" />

        <mj-text align="center" font-size="14px" color="#6b7280" padding-bottom="20px">
          Votre certificat est prêt. Partagez votre réussite avec votre réseau professionnel.
        </mj-text>

        <!-- Voir le certificat -->
        <mj-button
          background-color="#4f46e5"
          color="#ffffff"
          border-radius="10px"
          font-size="15px"
          font-weight="700"
          padding="14px 32px"
          href="{{ certificate_url }}"
          inner-padding="14px 32px">
          🎓 Voir mon Certificat
        </mj-button>

        <!-- LinkedIn -->
        <mj-button
          background-color="#0077b5"
          color="#ffffff"
          border-radius="10px"
          font-size="15px"
          font-weight="700"
          padding="14px 32px"
          href="{{ linkedin_url }}"
          inner-padding="14px 32px">
          🔗 Ajouter à LinkedIn
        </mj-button>

      </mj-column>
    </mj-section>

    <!-- MESSAGE INSTRUCTEUR -->
    <mj-section background-color="#fafafa" padding="32px 40px" border-left="4px solid #f59e0b">
      <mj-column>
        <mj-text font-size="14px" color="#374151" line-height="24px" font-style="italic">
          "{{ instructor_message }}"
        </mj-text>
        <mj-text font-size="13px" color="#9ca3af" padding-top="8px">
          — {{ instructor_name }}, Instructeur · MLAcademy
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- PROCHAINE ÉTAPE -->
    <mj-section background-color="#0f172a" padding="32px 40px" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#94a3b8" padding-bottom="8px">
          PROCHAINE ÉTAPE RECOMMANDÉE
        </mj-text>
        <mj-text align="center" font-size="16px" font-weight="700" color="#ffffff" padding-bottom="16px">
          {{ next_course_title }}
        </mj-text>
        <mj-button
          background-color="#f59e0b"
          color="#0f172a"
          border-radius="8px"
          font-size="14px"
          font-weight="800"
          href="{{ next_course_url }}"
          inner-padding="12px 28px">
          Continuer mon parcours →
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section padding="24px 40px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af" line-height="20px">
          MLAcademy · Cet email a été envoyé à {{ student_email }}<br/>
          <a href="{{ unsubscribe_url }}" style="color:#9ca3af;">Se désabonner</a> · 
          <a href="{{ privacy_url }}" style="color:#9ca3af;">Politique de confidentialité</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>